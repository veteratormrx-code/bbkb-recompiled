<?xml version="1.0" encoding="utf-8"?>
<!-- Shown only while the number row is on, so the symbol page stays as tall as the letters. -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <Key
        latin:keySpec="_"
        latin:moreKeys="–,—"/>
    <Key latin:keySpec="\\"/>
    <Key latin:keySpec="|"/>
    <Key latin:keySpec="&amp;"/>
    <Key
        latin:keySpec="!text/keyspec_symbols_tilde"
        latin:moreKeys="!text/morekeys_symbols_tilde"/>
    <Key latin:keySpec="!text/keyspec_less_than"/>
    <Key latin:keySpec="!text/keyspec_greater_than"/>
    <Key
        latin:keySpec="!text/keyspec_left_square_bracket"
        latin:moreKeys="!text/keyspec_left_curly_bracket"/>
    <Key
        latin:keySpec="!text/keyspec_right_square_bracket"
        latin:moreKeys="!text/keyspec_right_curly_bracket"/>
    <Key
        latin:keySpec="!text/keyspec_symbols_percent"
        latin:moreKeys="!text/morekeys_symbols_percent"/>
</merge>
